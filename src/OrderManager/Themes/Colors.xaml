<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ 调色板：清新浅色 ============ -->
    <Color x:Key="BrandColor">#2FA98C</Color>
    <Color x:Key="BrandDarkColor">#23856D</Color>
    <Color x:Key="BrandSoftColor">#E6F6F1</Color>

    <SolidColorBrush x:Key="Brand" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandDark" Color="{StaticResource BrandDarkColor}" />
    <SolidColorBrush x:Key="BrandSoft" Color="{StaticResource BrandSoftColor}" />

    <SolidColorBrush x:Key="BgWindow" Color="#F4F7F9" />
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgSidebar" Color="#FBFCFD" />
    <SolidColorBrush x:Key="BgHover" Color="#EEF2F5" />
    <SolidColorBrush x:Key="BgSelected" Color="#E6F6F1" />
    <SolidColorBrush x:Key="BgInput" Color="#F7F9FB" />

    <SolidColorBrush x:Key="TextPrimary" Color="#1F2A37" />
    <SolidColorBrush x:Key="TextSecondary" Color="#65717F" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA5B1" />
    <SolidColorBrush x:Key="TextOnBrand" Color="#FFFFFF" />

    <SolidColorBrush x:Key="BorderSoft" Color="#E8EDF1" />
    <SolidColorBrush x:Key="BorderInput" Color="#DFE5EB" />
    <!-- 表格行分隔线（通透模式下会换成半透明白） -->
    <SolidColorBrush x:Key="RowLine" Color="#F3F6F8" />

    <SolidColorBrush x:Key="Success" Color="#2FA98C" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#E6F6F1" />
    <SolidColorBrush x:Key="Warning" Color="#D9902F" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FDF3E3" />
    <SolidColorBrush x:Key="Danger" Color="#D95F57" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FCEDEC" />
    <SolidColorBrush x:Key="Info" Color="#4C86D9" />
    <SolidColorBrush x:Key="InfoSoft" Color="#EAF1FB" />
    <SolidColorBrush x:Key="NeutralSoft" Color="#F0F3F6" />

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">12.5</sys:Double>
    <sys:Double x:Key="FontSizeMd">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLg">16</sys:Double>
    <sys:Double x:Key="FontSizeXl">22</sys:Double>
    <sys:Double x:Key="FontSizeHero">30</sys:Double>

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>

    <!-- ============ 阴影 ============ -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270"
                      Color="#1B3A4B" Opacity="0.06" />

    <!-- ============ 基础文字样式 ============ -->
    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Subtle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXl}" />
    </Style>

    <!-- ============ 底部提示条（Toast） ============ -->
    <SolidColorBrush x:Key="ToastBg" Color="#F21F2A37" />
    <SolidColorBrush x:Key="ToastText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToastIcon" Color="#7FD9C2" />

</ResourceDictionary>

