<Window x:Class="OrderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="代肝管家"
        Icon="Assets/app.ico"
        Height="860" Width="1320" MinHeight="700" MinWidth="1120"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeMd}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 自定义背景层（设置里可以换图） ================= -->
        <Grid x:Name="BackdropLayer" Grid.Row="0" Grid.RowSpan="2"
              Visibility="Collapsed" ClipToBounds="True">
            <Image x:Name="BackdropImage" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="BackdropScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <Rectangle x:Name="BackdropTile" Visibility="Collapsed" />
            <!-- 视频壁纸（Wallpaper Engine 视频类）：静音循环播放 -->
            <MediaElement x:Name="BackdropVideo" Visibility="Collapsed"
                          Stretch="UniformToFill" IsMuted="True" ScrubbingEnabled="False"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          MediaFailed="BackdropVideo_MediaFailed" />
            <Rectangle x:Name="BackdropOverlay" Fill="{StaticResource BgWindow}" Opacity="0.78" />
        </Grid>

        <!-- ================= 顶部标题栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <Grid Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown"
                  MouseMove="TopBar_MouseMove" MouseLeftButtonUp="TopBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Brand}">
                        <TextBlock Text="代" Foreground="{StaticResource TextOnBrand}"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="代肝管家" Margin="10,0,0,0" FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{StaticResource BrandSoft}" CornerRadius="6"
                            Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="概览" FontSize="{StaticResource FontSizeXs}"
                                   Foreground="{StaticResource BrandDark}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource BtnWindow}" Click="Min_Click" Content="&#xE921;" ToolTip="最小化" />
                    <Button x:Name="MaxBtn" Style="{StaticResource BtnWindow}" Click="Max_Click" Content="&#xE922;" ToolTip="最大化" />
                    <Button Style="{StaticResource BtnWindowClose}" Click="Close_Click" Content="&#xE8BB;" ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= 左侧导航 ================= -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,12,0,0">
                        <TextBlock Text="主要" FontSize="{StaticResource FontSizeXs}"
                                   Foreground="{StaticResource TextMuted}" Margin="22,6,0,4" />
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}"
                                     Tag="&#xE80F;" Content="概览" IsChecked="True" Click="Nav_Click" />
                        <RadioButton x:Name="NavOrders" Style="{StaticResource NavItem}"
                                     Tag="&#xE8A5;" Content="订单管理" Click="Nav_Click" />
                        <RadioButton x:Name="NavCalendar" Style="{StaticResource NavItem}"
                                     Tag="&#xE787;" Content="托管日历" Click="Nav_Click" />

                        <TextBlock Text="经营" FontSize="{StaticResource FontSizeXs}"
                                   Foreground="{StaticResource TextMuted}" Margin="22,14,0,4" />
                        <RadioButton x:Name="NavReports" Style="{StaticResource NavItem}"
                                     Tag="&#xE8EF;" Content="统计报表" Click="Nav_Click" />
                        <RadioButton x:Name="NavRunners" Style="{StaticResource NavItem}"
                                     Tag="&#xE716;" Content="跑手管理" Click="Nav_Click" />
                        <RadioButton x:Name="NavItems" Style="{StaticResource NavItem}"
                                     Tag="&#xE8EC;" Content="价目表" Click="Nav_Click" />

                        <TextBlock Text="系统" FontSize="{StaticResource FontSizeXs}"
                                   Foreground="{StaticResource TextMuted}" Margin="22,14,0,4" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                     Tag="&#xE713;" Content="设置" Click="Nav_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="12,0,12,14">
                        <Button Style="{StaticResource BtnGhost}" Click="OpenData_Click"
                                HorizontalAlignment="Stretch" Height="34" ToolTip="打开数据库所在文件夹，方便备份">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="数据文件夹" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="VersionText" Text="v1.0 · 本地数据" FontSize="{StaticResource FontSizeXs}"
                                   Foreground="{StaticResource TextMuted}" Margin="14,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 页面容器（页面创建后一直留在可视树里，切换只改 Visibility） ================= -->
            <Grid Grid.Column="1">
                <Grid x:Name="PageHost" Margin="22,18,22,20" ClipToBounds="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PageShift" Y="0" />
                    </Grid.RenderTransform>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 底部提示条（Toast） ================= -->
        <Grid x:Name="ToastLayer" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"
              VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30">
            <Border x:Name="ToastBorder" Background="{StaticResource ToastBg}" CornerRadius="10"
                    Padding="17,9" Opacity="0" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#1F2A37" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="12" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource ToastIcon}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" Margin="9,0,0,0" FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource ToastText}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

