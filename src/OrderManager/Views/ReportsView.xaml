<UserControl x:Class="OrderManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}"
             FontSize="{StaticResource FontSizeMd}"
             Foreground="{StaticResource TextPrimary}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- 年份下拉项：浅色卡片风格 -->
        <Style x:Key="YearComboItem" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource BrandDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 年份下拉：简洁自定义模板，和整体浅色风格一致 -->
        <Style x:Key="YearCombo" TargetType="ComboBox" BasedOn="{StaticResource Combo}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource YearComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" SnapsToDevicePixels="True" />
                            <Grid Margin="12,0,10,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                      VerticalAlignment="Center" Margin="8,2,0,0" />
                            </Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                        CornerRadius="10" Padding="5" Margin="0,6,0,0" MinWidth="118">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ================= 标题栏 ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="统计报表" Style="{StaticResource H1}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="按年查看经营数据" Style="{StaticResource Subtle}" />
                        <TextBlock Text="·" Style="{StaticResource Subtle}" Margin="8,0" />
                        <TextBlock Text="数据来自本地订单库，实时计算" Style="{StaticResource Subtle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox Style="{StaticResource YearCombo}" Width="118"
                                  ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}" />
                        <Button Style="{StaticResource BtnPrimary}" Content="导出 CSV"
                                Command="{Binding ExportCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExportHint}" Style="{StaticResource Muted}"
                               HorizontalAlignment="Right" Margin="0,6,0,0" MaxWidth="420"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- ================= 年度 KPI ================= -->
            <ItemsControl ItemsSource="{Binding YearKpis}" Margin="-7,16,-7,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KpiCard}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" />
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold"
                                           Margin="0,7,0,0" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= 按月统计 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="按月统计" Style="{StaticResource H2}" />
                            <Border Background="{DynamicResource BrandSoft}" CornerRadius="6"
                                    Padding="8,2" Margin="10,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding YearTotalText}" FontSize="{StaticResource FontSizeXs}"
                                           Foreground="{StaticResource BrandDark}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MonthTotalText}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 表格整体限宽居中；列宽全部固定，避免星号列在超宽窗口里被压缩 -->
                    <Grid MaxWidth="1060" HorizontalAlignment="Center">
                        <StackPanel>

                            <TextBlock Text="该年份还没有订单记录，可先到「订单管理」新增订单"
                                       Style="{StaticResource Subtle}" Margin="0,14,0,0"
                                       Visibility="{Binding HasNoMonths, Converter={StaticResource BoolToVis}}" />

                            <!-- 表头 -->
                            <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                    Margin="4,14,4,0" Padding="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="月份" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="单数" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="营业额" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="我的分成" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="助手分成" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="跑手分成" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding MonthRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                                Margin="4,0" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="180" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MonthLabel}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding OrdersText}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Grid.Column="2" Text="{Binding AmountText}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="3" Text="{Binding MineText}"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource BrandDark}" />
                                                <TextBlock Grid.Column="4" Text="{Binding AssistantText}"
                                                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Grid.Column="5" Text="{Binding RunnerText}"
                                                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 分类 / 跑手 ================= -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 按项目分类 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="按项目分类" Style="{StaticResource H2}" />
                            <TextBlock Grid.Column="1" Text="按营业额排序" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="暂无分类数据" Style="{StaticResource Subtle}" Margin="0,16,0,0"
                                   Visibility="{Binding HasNoCategory, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding CategoryRows}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Column="1" Height="10" VerticalAlignment="Center"
                                              ClipToBounds="True" Margin="10,0">
                                            <Border Background="{DynamicResource NeutralSoft}" CornerRadius="5" />
                                            <Border Background="{StaticResource Brand}" CornerRadius="5"
                                                    Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding OrdersText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 按跑手 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="按跑手统计" Style="{StaticResource H2}" />
                            <TextBlock Grid.Column="1" Text="个人接单计入「个人自接」" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="暂无跑手数据" Style="{StaticResource Subtle}" Margin="0,16,0,0"
                                   Visibility="{Binding HasNoRunner, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding RunnerRows}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Column="1" Height="10" VerticalAlignment="Center"
                                              ClipToBounds="True" Margin="10,0">
                                            <Border Background="{DynamicResource NeutralSoft}" CornerRadius="5" />
                                            <Border Background="{StaticResource Brand}" CornerRadius="5"
                                                    Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding OrdersText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

