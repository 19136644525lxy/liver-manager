<UserControl x:Class="OrderManager.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 月历里的一天：托管期内薄荷绿底 + 品牌色细边，非托管期白底淡描边，今天加粗描边，已打卡右上角小圆点 -->
        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="MaxHeight" Value="76" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{DynamicResource BrandSoft}"
                                BorderBrush="{StaticResource Brand}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}">
                            <Grid>
                                <TextBlock x:Name="DayLabel"
                                           Text="{Binding DayText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeMd}"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Ellipse x:Name="Mark"
                                         Width="7"
                                         Height="7"
                                         Margin="0,7,8,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource Brand}"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInRange}" Value="False">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource BgCard}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
                                <Setter TargetName="DayLabel" Property="Foreground" Value="{DynamicResource TextMuted}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Brand}" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                                <Setter TargetName="DayLabel" Property="Foreground" Value="{StaticResource BrandDark}" />
                                <Setter TargetName="DayLabel" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCheckin}" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource BrandSoft}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Brand}" />
                                <Setter TargetName="DayLabel" Property="Foreground" Value="{StaticResource BrandDark}" />
                                <Setter TargetName="DayLabel" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource BgHover}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Brand}" />
                            </Trigger>
                            <!-- 占位格：不描边、不显示、但保留位置 -->
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter TargetName="Shell" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Shell" Property="Background" Value="Transparent" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Shell" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧托管订单卡片 -->
        <Style x:Key="OrderItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell"
                                Padding="12"
                                Background="{DynamicResource BgInput}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource BgSelected}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Brand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="托管日历" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding TodayHint}"
                           Style="{StaticResource Subtle}"
                           Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="上月" Style="{StaticResource BtnSecondary}"
                        Command="{Binding PreviousMonthCommand}" />
                <TextBlock Text="{Binding MonthTitle}"
                           Style="{StaticResource H2}"
                           MinWidth="112"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="下月" Style="{StaticResource BtnSecondary}"
                        Command="{Binding NextMonthCommand}" />
                <Button Content="今天打卡"
                        Style="{StaticResource BtnPrimary}"
                        Margin="10,0,0,0"
                        ToolTip="跳到今天所在月份并直接打卡；今天已经打过卡就只跳转，不会取消"
                        Command="{Binding TodayCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 托管订单列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="托管订单" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding OrderCountText}"
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Orders}"
                                 SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource OrderItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding BossName}"
                                                       Style="{StaticResource TextBase}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,64,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{StaticResource Muted}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding ItemName}"
                                                   Style="{StaticResource Subtle}"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RangeText}"
                                                   Style="{StaticResource Muted}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding CheckinText}"
                                                   Style="{StaticResource Muted}"
                                                   Foreground="{StaticResource BrandDark}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Top"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding ShowNoOrders, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="暂无托管订单"
                                       Style="{StaticResource TextBase}"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="在订单里填写托管开始与结束日期后，这里就会出现"
                                       Style="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 托管类订单但没填托管期的提醒 -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource WarningSoft}"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasMissingCustody, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding MissingCustodyHint}"
                                   Style="{StaticResource Muted}"
                                   Foreground="{StaticResource Warning}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- 月历：整体按内容高度排布，页脚进度条紧贴网格 -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedOrderTitle}"
                                       Style="{StaticResource H2}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,150,0" />
                            <TextBlock Text="点击托管期内的日期切换打卡"
                                       Style="{StaticResource Subtle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CheckinSummary}"
                                       Style="{StaticResource TextBase}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding MonthTitle}"
                                       Style="{StaticResource Muted}"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="7" Margin="3,0,3,6">
                        <TextBlock Text="一" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        <TextBlock Text="二" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        <TextBlock Text="三" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        <TextBlock Text="四" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        <TextBlock Text="五" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        <TextBlock Text="六" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        <TextBlock Text="日" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </UniformGrid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DayButtonStyle}"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.ToggleDayCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="3" Margin="3,14,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Height="10"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     BorderThickness="0"
                                     Background="{DynamicResource NeutralSoft}"
                                     Foreground="{StaticResource Brand}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border x:Name="PART_Track"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5" />
                                        <Border x:Name="PART_Indicator"
                                                Background="{TemplateBinding Foreground}"
                                                CornerRadius="5"
                                                HorizontalAlignment="Left" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressPercentText}"
                                   Style="{StaticResource Number}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

