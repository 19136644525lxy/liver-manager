<Window x:Class="OrderManager.Views.RenewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="续单"
        Width="560" Height="592"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource FontSizeMd}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgWindow}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="续单" Style="{StaticResource H2}" />
                        <TextBlock Text="在原有托管期后面顺延，日历会自动延长" Style="{StaticResource Muted}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BtnWindowClose}" Content="&#xE8BB;"
                            ToolTip="关闭" VerticalAlignment="Center" Click="Close_Click" />
                </Grid>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,18">
                <StackPanel>

                    <!-- 订单信息 -->
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding BossName}"
                                           Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeLg}" />
                                <Border Grid.Column="1" Background="{DynamicResource BrandSoft}"
                                        CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ItemText}" FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource BrandDark}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding OriginalRangeText}" Style="{StaticResource Subtle}"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="{Binding OriginalAmountText}" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 续单参数 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="续单月数是" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding MonthOptions}"
                                      SelectedItem="{Binding Months, Mode=TwoWay}"
                                      Style="{StaticResource Combo}"
                                      Height="36" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="本月追加金额（元，可不填）"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding ExtraAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input}" Height="36" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                <TextBlock Text="备注（可选，会追加到订单备注后面）" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input}" Height="34" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 预览 -->
                    <Border Style="{StaticResource SoftCard}" Padding="16,14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="续单后的托管期"
                                       Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewPeriodText}"
                                       Style="{StaticResource TextBase}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="续单后的订单金额"
                                       Style="{StaticResource Muted}" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewAmountText}"
                                       Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandDark}" Margin="0,10,0,0" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}"
                               Style="{StaticResource TextBase}" Margin="2,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ctrl+Enter 保存，Esc 退出"
                               Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="取消" Style="{StaticResource BtnSecondary}"
                            Width="92" Height="36" Margin="0,0,10,0"
                            Command="{Binding CancelCommand}" />
                    <Button Grid.Column="2" Content="确认续单" Style="{StaticResource BtnPrimary}"
                            Width="104" Height="36"
                            Command="{Binding SaveCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
