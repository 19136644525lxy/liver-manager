<UserControl x:Class="OrderManager.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OrderManager.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:TextToVisibilityConverter x:Key="TextToVis" />

        <!-- 分类折叠箭头 -->
        <Style x:Key="GroupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2">
                            <TextBlock x:Name="Arrow"
                                       Text="&#xE70D;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE76C;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource BrandDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="价目表" Style="{StaticResource H1}" />
                <TextBlock Text="按分类维护服务价目，下单时可直接引用"
                           Style="{StaticResource Subtle}"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Button Content="新增价目"
                    Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding NewItemCommand}" />
        </Grid>

        <!-- 操作提示条 -->
        <Border Grid.Row="1"
                Padding="14,10"
                Margin="0,0,0,14"
                Background="{DynamicResource BrandSoft}"
                CornerRadius="{StaticResource RadiusMd}"
                Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}">
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource TextBase}"
                       Foreground="{StaticResource BrandDark}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 价目列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="价目清单" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding TotalText}"
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 搜索框：图标 + 输入 + 占位文字 -->
                    <Grid Grid.Row="1" Height="36" Margin="0,12,0,14">
                        <Border Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource BorderInput}"
                                BorderThickness="1"
                                CornerRadius="9" />
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <TextBox Height="34"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         FontFamily="{StaticResource AppFont}"
                                         FontSize="{StaticResource FontSizeMd}"
                                         Foreground="{StaticResource TextPrimary}"
                                         CaretBrush="{StaticResource Brand}"
                                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="搜索名称、分类或备注"
                                           Style="{StaticResource Muted}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Keyword, Converter={StaticResource TextToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Category}"
                                                           Style="{StaticResource H2}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               Style="{StaticResource Muted}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <ToggleButton Style="{StaticResource GroupToggleStyle}"
                                                                  Margin="6,0,0,0"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource SoftCard}"
                                                                Width="248"
                                                                Margin="0,0,12,12">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Style="{StaticResource TextBase}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,0,56,0" />
                                                                    <TextBlock Text="{Binding PriceText}"
                                                                               Style="{StaticResource Number}"
                                                                               Foreground="{StaticResource BrandDark}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Note}"
                                                                           Style="{StaticResource Subtle}"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="38"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,6,0,0"
                                                                           Visibility="{Binding Note, Converter={StaticResource TextToVis}}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                    <Button Content="编辑"
                                                                            Style="{StaticResource BtnGhost}"
                                                                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Content="删除"
                                                                            Style="{StaticResource BtnDanger}"
                                                                            Margin="6,0,0,0"
                                                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel VerticalAlignment="Top"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding ShowNoItems, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="没有匹配的价目"
                                       Style="{StaticResource TextBase}"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="换个关键词试试，或点右上角「新增价目」"
                                       Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右侧：编辑卡片 / 说明 -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource Card}"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}" />
                        <TextBlock Text="价格可以留空，只维护名称也可以"
                                   Style="{StaticResource Subtle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="名称" Style="{StaticResource Muted}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="分类" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                        <ComboBox Style="{StaticResource Combo}"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding EditCategory, Mode=TwoWay}" />

                        <TextBlock Text="价格（元）" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="备注" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                        <TextBox Style="{StaticResource InputMultiline}"
                                 Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="保存"
                                    Style="{StaticResource BtnPrimary}"
                                    Command="{Binding SaveItemCommand}" />
                            <Button Content="取消"
                                    Style="{StaticResource BtnSecondary}"
                                    Margin="10,0,0,0"
                                    Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="价目说明" Style="{StaticResource H2}" />
                        <Border Margin="0,14,0,0"
                                Padding="14"
                                Background="{DynamicResource BrandSoft}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock Text="价目按「托管服务 / 任务活动 / 地图满探索」三类展示，价格可在下单时快速带出。"
                                       Style="{StaticResource TextBase}"
                                       Foreground="{StaticResource BrandDark}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                        </Border>
                        <TextBlock Text="上方搜索框支持按名称、分类和备注过滤；点分类右侧箭头可以折叠分组。"
                                   Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,14,0,0" />
                        <Border Height="1"
                                Background="{DynamicResource BorderSoft}"
                                Margin="0,16,0,0" />
                        <TextBlock Text="点卡片上的「编辑」修改价目，点「删除」会先二次确认；保存后其他页面会同步刷新。"
                                   Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

