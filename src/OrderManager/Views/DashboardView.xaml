<UserControl x:Class="OrderManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OrderManager.Converters"
             FontFamily="{StaticResource AppFont}"
             FontSize="{StaticResource FontSizeMd}"
             Foreground="{StaticResource TextPrimary}">

    <UserControl.Resources>
        <c:StatusBrushConverter x:Key="StatusBrush" />
        <c:StatusBgConverter x:Key="StatusBg" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ================= 标题栏 ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource H1}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TodayText}" Style="{StaticResource Subtle}" />
                        <TextBlock Text="·" Style="{StaticResource Subtle}" Margin="8,0" />
                        <TextBlock Text="{Binding ShopText}" Style="{StaticResource Subtle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource BtnPrimary}" Content="刷新"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- ================= 今日 KPI ================= -->
            <ItemsControl ItemsSource="{Binding TodayKpis}" Margin="-7,16,-7,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KpiCard}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" />
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold"
                                           Margin="0,7,0,0" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= 主体 ================= -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左列 ===== -->
                <StackPanel Grid.Column="0">

                    <!-- 今日订单 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="今日订单" Style="{StaticResource H2}" />
                                    <Border Background="{DynamicResource BrandSoft}" CornerRadius="6"
                                            Padding="8,2" Margin="10,2,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TodayOrdersSubText}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource BrandDark}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="最多显示 6 条"
                                           Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 空态：整块居中，不显示表头 -->
                            <StackPanel Margin="0,34,0,30"
                                        Visibility="{Binding HasNoTodayOrders, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="今天还没有订单记录" FontSize="{StaticResource FontSizeLg}"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="到「订单管理」新增第一单，今日数据会自动统计"
                                           Style="{StaticResource Muted}" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- 订单表：有数据时才显示（表头跟着一起隐藏） -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoTodayOrders}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- 表头 -->
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                        Margin="4,14,4,0" Padding="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.35*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="客户" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="项目" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="2" Text="金额" Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding TodayOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                                    Margin="4,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.35*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="84" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BossName}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PersonalText}"
                                                                   Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Item}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding QuantityText}"
                                                                   Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center">
                                                        <Run Text="¥" Foreground="{DynamicResource TextMuted}" />
                                                        <Run Text="{Binding AmountText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>

                                                    <Border Grid.Column="3" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                                            Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 近 7 天营业额 -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="近 7 天营业额" Style="{StaticResource H2}" />
                                <TextBlock Grid.Column="1" Text="{Binding TrendTotalText}"
                                           Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,12,0,0" MinHeight="178">
                                <ItemsControl ItemsSource="{Binding Trend}"
                                              Visibility="{Binding HasTrend, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,0">
                                                <TextBlock Text="{Binding AmountText}" Style="{StaticResource Muted}"
                                                           HorizontalAlignment="Center" MinHeight="16" />
                                                <Grid Height="112" Margin="0,6,0,0">
                                                    <Border Height="{Binding Height}" VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Stretch" CornerRadius="6,6,2,2"
                                                            Margin="12,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource Brand}" />
                                                                <Setter Property="Opacity" Value="0.30" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource NeutralSoft}" />
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding DayLabel}" Style="{StaticResource Muted}"
                                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasNoTrend, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="近 7 天暂无营业额" Style="{StaticResource Subtle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="新增订单后这里会自动生成每日趋势" Style="{StaticResource Muted}"
                                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 右列 ===== -->
                <StackPanel Grid.Column="2">

                    <!-- 待办提醒 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="待办提醒" Style="{StaticResource H2}" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingTotalText}"
                                           Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </Grid>

                            <Border Background="{DynamicResource WarningSoft}" CornerRadius="10"
                                    Padding="14,11" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="待付款" FontWeight="SemiBold" />
                                        <TextBlock Text="客户还没付款的订单" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PendingPaymentText}"
                                               FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Warning}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource InfoSoft}" CornerRadius="10"
                                    Padding="14,11" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="待结算" FontWeight="SemiBold" />
                                        <TextBlock Text="完成但还没结算的订单" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PendingSettleText}"
                                               FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Info}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                                    Padding="14,10,14,0" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="进行中订单" FontWeight="SemiBold" />
                                        <TextBlock Text="每天需要打卡跟进的订单" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding InProgressText}"
                                               FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandDark}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 本月经营 -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="本月经营" Style="{StaticResource H2}" />
                                <TextBlock Grid.Column="1" Text="至今" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MonthKpis}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

