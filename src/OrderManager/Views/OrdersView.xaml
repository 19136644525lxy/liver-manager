<UserControl x:Class="OrderManager.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OrderManager.Converters"
             FontFamily="{StaticResource AppFont}"
             FontSize="{StaticResource FontSizeMd}"
             Foreground="{StaticResource TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <c:StatusBrushConverter x:Key="StatusBrush" />
        <c:StatusBgConverter x:Key="StatusBg" />
        <c:TextToVisibilityConverter x:Key="TextToVis" />

        <!-- 单元格文字 -->
        <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        </Style>

        <Style x:Key="CellSecondary" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="GridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- 日期快捷筛选胶囊按钮 -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandSoft}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand}" />
                                <Setter Property="Foreground" Value="{StaticResource BrandDark}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日期选择器：贴合整体浅色风格 -->
        <Style TargetType="DatePicker" BasedOn="{StaticResource DateField}">
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- 项目列：超出省略号 + 悬停看全名 -->
        <Style x:Key="CellItemText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="ToolTip" Value="{Binding Item}" />
        </Style>

        <!-- 下拉项：浅色 hover / 选中态 -->
        <Style x:Key="FilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource BrandDark}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：白底 + 细描边 + 圆角 + 灰色箭头（统一浅色模板） -->
        <ControlTemplate x:Key="FilterComboTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="{DynamicResource BgCard}"
                                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                    CornerRadius="9">
                                <Path Data="M 0 0 L 9 0 L 4.5 5 Z" Width="9" Height="5"
                                      Fill="{DynamicResource TextMuted}" Stretch="Fill"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,13,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="12,0,30,0" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />

                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                       Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                            CornerRadius="10" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#1B2A33" BlurRadius="16" ShadowDepth="3"
                                              Opacity="0.12" Direction="270" />
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource Combo}">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Template" Value="{StaticResource FilterComboTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboItem}" />
        </Style>

        <!-- 行内操作小按钮：透明底，悬停出现浅色背景，禁用时淡出 -->
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSelected}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowActionDanger" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 页面标题 + 操作 ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="订单管理" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding HeaderHint}" Style="{StaticResource Subtle}" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnSecondary}" Content="导出 CSV"
                        Height="38" Padding="18,0" Command="{Binding ExportCsvCommand}" />
                <Button Style="{StaticResource BtnPrimary}" Content="新增订单"
                        Height="38" Padding="22,0" Margin="10,0,0,0" Command="{Binding AddCommand}" />
            </StackPanel>
        </Grid>

        <!-- ================= 筛选工具栏 ================= -->
        <Border Grid.Row="1" Style="{StaticResource SoftCard}" Padding="16,14" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 关键词搜索 -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Height="34"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="搜索老板 / 项目 / 电话 / 跑手 / 备注"
                                   Style="{StaticResource Subtle}" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="12,0,10,0"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Keyword, Converter={StaticResource TextToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- 状态筛选 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="状态" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="124" Height="34"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="日期" Style="{StaticResource Subtle}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Presets}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Chip}" Content="{Binding Name}"
                                             GroupName="{Binding Name}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <DatePicker Width="132" SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="至" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="8,0" />
                        <DatePicker Width="132" SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="重置筛选"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding ResetCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= 订单表格 ================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="订单列表" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="双击行可编辑，右键可改状态" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowAction}" Content="编辑"
                                Command="{Binding EditCommand}" />
                        <Button x:Name="StatusButton" Style="{StaticResource RowAction}" Content="改状态"
                                IsEnabled="{Binding HasSelection}" Click="StatusButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="待付款" Command="{Binding SetStatusCommand}" CommandParameter="待付款" />
                                    <MenuItem Header="进行中" Command="{Binding SetStatusCommand}" CommandParameter="进行中" />
                                    <MenuItem Header="待结算" Command="{Binding SetStatusCommand}" CommandParameter="待结算" />
                                    <MenuItem Header="已完成" Command="{Binding SetStatusCommand}" CommandParameter="已完成" />
                                    <MenuItem Header="已取消" Command="{Binding SetStatusCommand}" CommandParameter="已取消" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource RowAction}" Content="续单"
                                ToolTip="托管订单：把托管期往后顺延，可同时追加金额"
                                Command="{Binding RenewCommand}" />
                        <Button Style="{StaticResource RowActionDanger}" Content="删除"
                                IsEnabled="{Binding HasSelection}" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="OrdersGrid" Style="{StaticResource Grid}"
                              ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              PreviewMouseRightButtonDown="OrdersGrid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="编辑订单" Command="{Binding EditCommand}" />
                                <MenuItem Header="续单（托管）" Command="{Binding RenewCommand}" />
                                <MenuItem Header="修改状态">
                                    <MenuItem Header="待付款" Command="{Binding SetStatusCommand}" CommandParameter="待付款" />
                                    <MenuItem Header="进行中" Command="{Binding SetStatusCommand}" CommandParameter="进行中" />
                                    <MenuItem Header="待结算" Command="{Binding SetStatusCommand}" CommandParameter="待结算" />
                                    <MenuItem Header="已完成" Command="{Binding SetStatusCommand}" CommandParameter="已完成" />
                                    <MenuItem Header="已取消" Command="{Binding SetStatusCommand}" CommandParameter="已取消" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="删除订单" Command="{Binding DeleteCommand}" Foreground="{StaticResource Danger}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Width="76"
                                                Binding="{Binding DateShort}"
                                                ElementStyle="{StaticResource CellSecondary}" />

                            <DataGridTemplateColumn Header="老板" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BossName}" Style="{StaticResource CellText}"
                                                   FontWeight="SemiBold" ToolTip="{Binding Phone}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="项目" Width="200"
                                                Binding="{Binding Item}"
                                                ElementStyle="{StaticResource CellItemText}" />

                            <DataGridTextColumn Header="数量" Width="52" HeaderStyle="{StaticResource GridHeaderRight}"
                                                Binding="{Binding QuantityText}"
                                                ElementStyle="{StaticResource CellNumber}" />

                            <DataGridTextColumn Header="金额" Width="84" HeaderStyle="{StaticResource GridHeaderRight}"
                                                Binding="{Binding AmountText}"
                                                ElementStyle="{StaticResource CellNumber}" />

                            <DataGridTextColumn Header="我" Width="70" HeaderStyle="{StaticResource GridHeaderRight}"
                                                Binding="{Binding MineText}"
                                                ElementStyle="{StaticResource CellNumber}" />

                            <DataGridTextColumn Header="助手" Width="68" HeaderStyle="{StaticResource GridHeaderRight}"
                                                Binding="{Binding AssistantText}"
                                                ElementStyle="{StaticResource CellNumber}" />

                            <DataGridTextColumn Header="跑手分成" Width="72" HeaderStyle="{StaticResource GridHeaderRight}"
                                                Binding="{Binding RunnerShare, StringFormat={}{0:0.00}}"
                                                ElementStyle="{StaticResource CellNumber}" />

                            <DataGridTemplateColumn Header="状态" Width="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusBg}}"
                                                CornerRadius="6" Padding="9,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                       FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="跑手" Width="72"
                                                Binding="{Binding RunnerText}"
                                                ElementStyle="{StaticResource CellSecondary}" />

                            <DataGridTemplateColumn Header="备注" Width="*" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource CellSecondary}"
                                                   ToolTip="{Binding Note}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource BrandSoft}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{StaticResource Brand}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource H2}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Subtle}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="380" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= 底部汇总条 ================= -->
        <Border Grid.Row="3" Style="{StaticResource SoftCard}" Padding="18,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="筛选结果" Style="{StaticResource Subtle}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />

                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0" Padding="18,0">
                    <StackPanel>
                        <TextBlock Text="单数" Style="{StaticResource SummaryLabel}" />
                        <TextBlock Text="{Binding Summary.Orders}" Style="{StaticResource SummaryValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0" Padding="18,0">
                    <StackPanel>
                        <TextBlock Text="总额" Style="{StaticResource SummaryLabel}" />
                        <TextBlock Text="{Binding Summary.AmountText}" Style="{StaticResource SummaryValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0" Padding="18,0">
                    <StackPanel>
                        <TextBlock Text="我" Style="{StaticResource SummaryLabel}" />
                        <TextBlock Text="{Binding Summary.MineText}" Style="{StaticResource SummaryValue}"
                                   Foreground="{StaticResource BrandDark}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0" Padding="18,0">
                    <StackPanel>
                        <TextBlock Text="助手" Style="{StaticResource SummaryLabel}" />
                        <TextBlock Text="{Binding Summary.AssistantText}" Style="{StaticResource SummaryValue}"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0" Padding="18,0">
                    <StackPanel>
                        <TextBlock Text="跑手" Style="{StaticResource SummaryLabel}" />
                        <TextBlock Text="{Binding Summary.RunnerText}" Style="{StaticResource SummaryValue}"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>


