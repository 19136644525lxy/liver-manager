<UserControl x:Class="OrderManager.Views.RunnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OrderManager.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:TextToVisibilityConverter x:Key="TextToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="跑手管理" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource Subtle}"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Button Content="新增跑手"
                    Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding NewRunnerCommand}" />
        </Grid>

        <!-- 操作提示条 -->
        <Border Grid.Row="1"
                Padding="14,10"
                Margin="0,0,0,14"
                Background="{DynamicResource BrandSoft}"
                CornerRadius="{StaticResource RadiusMd}"
                Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}">
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource TextBase}"
                       Foreground="{StaticResource BrandDark}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 跑手列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <DataGrid Style="{StaticResource Grid}"
                              ItemsSource="{Binding Runners}"
                              SelectedItem="{Binding SelectedRunner, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="分成比例" Binding="{Binding RateText}" Width="120" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Active}" Width="80" />
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="编辑"
                                                    Style="{StaticResource BtnGhost}"
                                                    Command="{Binding DataContext.EditRunnerCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除"
                                                    Style="{StaticResource BtnDanger}"
                                                    MinWidth="56"
                                                    Padding="10,0"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteRunnerCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Top"
                                Margin="0,56,0,0"
                                Visibility="{Binding ShowNoRunners, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="还没有跑手"
                                   Style="{StaticResource TextBase}"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="点击右上角「新增跑手」添加第一位跑手"
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：编辑卡片 / 分成提示 -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource Card}"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}" />
                        <TextBlock Text="分成比例按百分比填写，例如 80 表示 80%"
                                   Style="{StaticResource Subtle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="姓名" Style="{StaticResource Muted}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="分成比例（%）" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditRate, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="备注" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                        <TextBox Style="{StaticResource InputMultiline}"
                                 Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <CheckBox Style="{StaticResource Check}"
                                  Content="启用该跑手"
                                  IsChecked="{Binding EditActive}"
                                  Margin="0,16,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="保存"
                                    Style="{StaticResource BtnPrimary}"
                                    Command="{Binding SaveRunnerCommand}" />
                            <Button Content="取消"
                                    Style="{StaticResource BtnSecondary}"
                                    Margin="10,0,0,0"
                                    Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="分成提示" Style="{StaticResource H2}" />
                        <Border Margin="0,14,0,0"
                                Padding="14"
                                Background="{DynamicResource BrandSoft}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock Text="{Binding XiaoyuHint}"
                                       Style="{StaticResource TextBase}"
                                       Foreground="{StaticResource BrandDark}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                        </Border>
                        <TextBlock Text="{Binding RuleHint}"
                                   Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,14,0,0" />
                        <Border Height="1"
                                Background="{DynamicResource BorderSoft}"
                                Margin="0,16,0,0" />
                        <TextBlock Text="在列表里点「编辑」可以修改姓名、分成比例、备注与启用状态；删除前会再次确认。"
                                   Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

