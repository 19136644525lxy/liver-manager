<Window x:Class="OrderManager.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="订单"
        Width="800" Height="740"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource FontSizeMd}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        </Style>

        <Style x:Key="PreviewLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="PreviewValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXl}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- 日期选择器：贴合整体浅色风格 -->
        <Style TargetType="DatePicker" BasedOn="{StaticResource DateField}" />
    </Window.Resources>

    <Border Background="{StaticResource BgWindow}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <!-- ================= 窗口标题 ================= -->
            <Border Grid.Row="0" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding SubTitle}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource BtnWindowClose}" Content="&#xE8BB;"
                            ToolTip="关闭" VerticalAlignment="Center" Click="Close_Click" />
                </Grid>
            </Border>

            <!-- ================= 表单主体 ================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="22,16,22,6">
                <StackPanel>

                    <!-- 客户信息 -->
                    <Border Style="{StaticResource SoftCard}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="客户信息" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="老板网名" /><Run Text=" *" Foreground="{StaticResource Danger}" />
                                    </TextBlock>
                                    <TextBox Style="{StaticResource Input}" MaxLength="40"
                                             Text="{Binding BossName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="联系电话" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Input}" MaxLength="30"
                                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 订单信息 -->
                    <Border Style="{StaticResource SoftCard}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="订单信息" Style="{StaticResource SectionTitle}" />

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="项目（可从价目表选择，自动带出金额）" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource Combo}" IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          ItemsSource="{Binding Items}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                          Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="数量" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="金额（元）" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,10,0">
                                    <TextBlock Text="订单状态" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Combo}"
                                              ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                    <TextBlock Text="订单日期" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding OrderDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 分配与托管 -->
                    <Border Style="{StaticResource SoftCard}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="分配与托管" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource Check}"
                                          Content="个人接单（不分配跑手）" VerticalAlignment="Center"
                                          IsChecked="{Binding Personal, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                           Text="个人接单时助手分成按个人规则计算；取消勾选后可指定跑手。" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="跑手" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource Combo}"
                                              ItemsSource="{Binding RunnerNames}"
                                              SelectedItem="{Binding RunnerName, Mode=TwoWay}"
                                              IsEnabled="{Binding IsRunnerEnabled}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="托管开始日期" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="托管结束日期" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CustodyHint}" Style="{StaticResource Muted}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 备注 -->
                    <Border Style="{StaticResource SoftCard}" Padding="18,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="备注" Style="{StaticResource SectionTitle}" />
                            <TextBox Style="{StaticResource InputMultiline}" MinHeight="64" Margin="0,10,0,0"
                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 分成预览（固定在表单与按钮之间，滚动时始终可见） ================= -->
            <Border Grid.Row="2" Background="{DynamicResource BrandSoft}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="分成预览" FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold" Foreground="{StaticResource BrandDark}"
                               VerticalAlignment="Center" Margin="0,0,20,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="我" Style="{StaticResource PreviewLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding MinePreview}" FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" FontFamily="Segoe UI, Microsoft YaHei UI"
                                   Foreground="{StaticResource BrandDark}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="助手" Style="{StaticResource PreviewLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding AssistantPreview}" FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" FontFamily="Segoe UI, Microsoft YaHei UI"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="跑手" Style="{StaticResource PreviewLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding RunnerPreview}" FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" FontFamily="Segoe UI, Microsoft YaHei UI"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="4" Text="{Binding KindText}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" ToolTip="按当前分成规则实时计算，保存后以实际规则为准。" />
                </Grid>
            </Border>

            <!-- ================= 底部操作 ================= -->
            <Border Grid.Row="3" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource BtnDanger}" Content="删除订单"
                                Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}"
                               FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                               Margin="14,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnSecondary}" Content="取消" MinWidth="88"
                                Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource BtnPrimary}" Content="保存" MinWidth="112"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

